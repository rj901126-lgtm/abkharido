# Set private random values separately in each deployment. Never commit .env.
JWT_SECRET=
NEXTAUTH_SECRET=
ADMIN_SECURE_PIN=
CRON_SECRET=
DATABASE_ENCRYPTION_KEY=
DATABASE_ENCRYPTION_SALT=
NEXTAUTH_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Financial transactions require a MongoDB replica set (Docker config provides one).
MONGODB_URI=mongodb://localhost:27017/abkharido?replicaSet=abkharido-rs
REDIS_URI=
FIREBASE_PROJECT_ID=
# Firebase Admin credentials: standard GOOGLE_APPLICATION_CREDENTIALS file or ADC.
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
ALLOW_PAYMENT_SIMULATION=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
