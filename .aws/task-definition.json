{
    "family": "abkharido-task-family",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "abkharido-frontend",
            "image": "<IMAGE1_NAME>",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/abkharido-frontend",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        },
        {
            "name": "abkharido-backend",
            "image": "<IMAGE2_NAME>",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp"
                }
            ],
            "secrets": [
                {
                    "name": "MONGO_URI",
                    "valueFrom": "arn:aws:ssm:ap-south-1:123456789012:parameter/abkharido/MONGO_URI"
                },
                {
                    "name": "REDIS_URI",
                    "valueFrom": "arn:aws:ssm:ap-south-1:123456789012:parameter/abkharido/REDIS_URI"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/abkharido-backend",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::123456789012:role/ecsTaskRole"
}
